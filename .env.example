# Copy to .env and fill in the blanks. Never commit .env.

# Core
VSA_ENV=dev
VSA_LOG_LEVEL=INFO
VSA_SENTRY_DSN_API=
VSA_SENTRY_DSN_CONSOLE=

# Database (async SQLAlchemy + asyncpg; statement cache off for pooled Neon endpoint)
VSA_DB_URL=postgresql+asyncpg://vsa:vsa@localhost:5432/vsa
VSA_DB_STATEMENT_CACHE_SIZE=0

# Redis — two logical DBs: session (noeviction) and cache (allkeys-lru)
VSA_REDIS_SESSION_URL=redis://localhost:6379/0
VSA_REDIS_CACHE_URL=redis://localhost:6379/1

# Clerk (identity + membership authoritative)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# LLM — single provider in Sprint 1
VSA_LLM_OPENAI_API_KEY=
VSA_LLM_DEFAULT_MODEL=gpt-4o-mini
VSA_LLM_CHAT_TIMEOUT_S=20
VSA_LLM_EMBEDDING_TIMEOUT_S=60
VSA_LLM_MAX_RESPONSE_TOKENS=800

# Runtime caps
VSA_AGENT_CONCURRENT_SESSIONS_MAX=50

# App URLs
VSA_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_VSA_API_BASE_URL=http://localhost:8000
